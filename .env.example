# Feishu app and Base (server only)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_BASE_APP_TOKEN=
FEISHU_TEMPLATE_TABLE_ID=
FEISHU_INSTANCE_TABLE_ID=

# Coupon OA P0 (server only). Configure the existing Feishu OA initiation URL at deployment.
FEISHU_COUPON_OA_INITIATE_URL=

# Coupon OA automatic filling (server only)
# `draft-demo` limits the bot to fixed fields -> Base. It never accepts attachments or creates OA.
# Set this to `production` before enabling the Excel P1-1 → OA-draft handoff;
# the handoff uploads the two confirmed workbooks but never submits a native OA.
# Keep FEISHU_VERIFICATION_TOKEN unset when using the local lark-cli long-connection bridge,
# because bridge events do not carry the HTTP webhook verification token.
FEISHU_COUPON_OA_MODE=draft-demo
# Target native approval: 【拍拍】优惠券申请及修改. Must be an approval_code, not an AppLink token.
FEISHU_COUPON_OA_APPROVAL_CODE=34F3F8E4-90D9-4A3C-8C61-F05D97FD0941
# Dedicated Base table for unsubmitted coupon OA drafts.
FEISHU_COUPON_DRAFT_TABLE_ID=

# Coupon Excel P1-1 internal pilot (server only)
# Keep this false until the dedicated Base table, Drive folder, and app permissions are ready.
FEISHU_COUPON_EXCEL_PILOT_ENABLED=false
# Dedicated Base table. Do not reuse FEISHU_COUPON_DRAFT_TABLE_ID.
FEISHU_COUPON_EXCEL_PILOT_TABLE_ID=
# Application-managed Feishu Drive folder for generated .xlsx artifacts.
FEISHU_COUPON_EXCEL_PILOT_FOLDER_TOKEN=
# Used only to extract structured fields from the business user's text. Never expose in cards or clients.
DEEPSEEK_API_KEY=
# Optional; defaults shown below.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Administrator API: local development only. Never enable development mode in production.
ADMIN_AUTH_MODE=development
ADMIN_DEV_OPEN_IDS=ou_replace_with_test_admin
ADMIN_ALLOWED_ORIGINS=http://localhost:5173
