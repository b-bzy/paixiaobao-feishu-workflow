# Feishu app and Base (server only)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_APP_TOKEN=
FEISHU_TEMPLATE_TABLE_ID=
FEISHU_INSTANCE_TABLE_ID=

# Coupon OA P0 (server only). Configure the existing Feishu OA initiation URL at deployment.
FEISHU_COUPON_OA_INITIATE_URL=

# Coupon OA automatic filling (server only)
# The workflow is disabled unless this is explicitly draft-demo or native-submit.
# `draft-demo` limits the bot to fixed fields -> Base. It never accepts attachments or creates OA.
# `native-submit` alone never authorizes native OA creation: the explicit enable flag and server-side
# open-ID allowlist below must also pass. This file is a local example, not launch authorization.
FEISHU_COUPON_OA_MODE=disabled
# Every stateful coupon OA operation is deny-by-default; list only trial users here.
FEISHU_COUPON_OA_ALLOWED_OPEN_IDS=
# Native approval creation remains fail-closed until an R3/R4 canary is explicitly authorized.
FEISHU_COUPON_OA_NATIVE_SUBMIT_ENABLED=false
FEISHU_COUPON_OA_NATIVE_SUBMIT_ALLOWED_OPEN_IDS=
# Target native approval: 【拍拍】优惠券申请及修改. Must be an approval_code, not an AppLink token.
FEISHU_COUPON_OA_APPROVAL_CODE=34F3F8E4-90D9-4A3C-8C61-F05D97FD0941
# Dedicated Base table for unsubmitted coupon OA drafts.
FEISHU_COUPON_DRAFT_TABLE_ID=

# Feishu HTTP callback only. Public /api/feishu/process fails closed when this is absent.
FEISHU_VERIFICATION_TOKEN=

# Development/managed bridge ingress. The bridge has no implicit remote target: set the exact
# route and a separately rotated HMAC secret. Set P0 mode only for the temporary strict
# three-source POC; it requires /api/feishu/poc-bridge rather than the durable bridge route.
# Local HTTP is allowed only for an explicit loopback target and must never be set in a managed
# or deployed environment.
FEISHU_BRIDGE_TARGET_URL=http://127.0.0.1:3000/api/feishu/bridge
FEISHU_BRIDGE_P0_MODE=false
# Required in P0 mode: full immutable Git SHA expected from the target Preview.
FEISHU_P0_EXPECTED_GIT_SHA=
FEISHU_BRIDGE_ALLOW_HTTP=true
FEISHU_BRIDGE_KEY_ID=local-bridge-v1
FEISHU_BRIDGE_SHARED_SECRET=
# Optional comma-separated long-connection consumer allowlist. Default subscribes to both
# supported event types; R0.5 smoke must set only im.message.receive_v1.
FEISHU_BRIDGE_EVENT_TYPES=im.message.receive_v1,card.action.trigger
# Bound each HTTP forward. Values must be an integer from 1000 to 60000; default is 10000.
FEISHU_BRIDGE_FORWARD_TIMEOUT_MS=10000
# Optional local-runner credential for a Vercel Deployment Protection protected target.
# It is sent only as x-vercel-protection-bypass and is not part of the Feishu HMAC contract.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Durable coupon control plane. Keep stage=local until PostgreSQL migrations, object
# storage, managed bridge ACK semantics, worker health, and R1 evidence all pass.
# Legacy Base-driven POC handlers are rejected in non-local stages unless explicitly
# enabled for a controlled migration window; do not enable both route families.
FEISHU_RUNTIME_STAGE=local
FEISHU_LEGACY_POC_ENABLED=false
DATABASE_URL=
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
OBJECT_STORE_FORCE_PATH_STYLE=false
FEISHU_BRIDGE_INSTANCE_ID=
# Stable scheduler/worker identity, distinct per deployed worker instance.
FEISHU_WORKER_ID=
# Internal POST /api/internal/control-plane/tick bearer token; use a unique
# 32+ character secret. Leave empty to make the tick endpoint unavailable.
CONTROL_PLANE_TICK_TOKEN=
CONTROL_PLANE_WORKER_JOB_LIMIT=10
CONTROL_PLANE_WORKER_EFFECT_LIMIT=10
CONTROL_PLANE_WORKER_JOB_LEASE_MS=60000
CONTROL_PLANE_WORKER_EFFECT_LEASE_MS=60000
CONTROL_PLANE_WORKER_SCHEDULER_LEASE_MS=90000

# Coupon Excel P1-1 internal pilot (server only)
# Keep this false until the dedicated Base table, Drive folder, and app permissions are ready.
FEISHU_COUPON_EXCEL_PILOT_ENABLED=false
# Dedicated Base table. Do not reuse FEISHU_COUPON_DRAFT_TABLE_ID.
FEISHU_COUPON_EXCEL_PILOT_TABLE_ID=
# Application-managed Feishu Drive folder for generated .xlsx artifacts.
FEISHU_COUPON_EXCEL_PILOT_FOLDER_TOKEN=

# Coupon three-source strict-only Bot pilot. Keep disabled until the dedicated Base table,
# Drive folder, templates, and existing coupon-OA test-draft controls are ready.
FEISHU_COUPON_THREE_SOURCE_PILOT_ENABLED=false
# Dedicated Base app: do not reuse FEISHU_BASE_APP_TOKEN, which belongs to legacy routes.
FEISHU_COUPON_THREE_SOURCE_PILOT_BASE_APP_TOKEN=
FEISHU_COUPON_THREE_SOURCE_PILOT_TABLE_ID=
FEISHU_COUPON_THREE_SOURCE_PILOT_FOLDER_TOKEN=

# Coupon three-source R2 draft-only foundation. This remains fail-closed until
# every listed value is configured and the durable runtime is implemented.
# Do not reuse the legacy coupon-OA or Excel-pilot Base/Drive resources.
FEISHU_COUPON_THREE_SOURCE_R2_ENABLED=false
FEISHU_COUPON_THREE_SOURCE_R2_ALLOWED_OPEN_IDS=
FEISHU_COUPON_THREE_SOURCE_R2_TASK_TABLE_ID=
FEISHU_COUPON_THREE_SOURCE_R2_REVISION_TABLE_ID=
FEISHU_COUPON_THREE_SOURCE_R2_DRIVE_FOLDER_TOKEN=
FEISHU_COUPON_THREE_SOURCE_R2_MAPPING_ID=
FEISHU_COUPON_THREE_SOURCE_R2_MAPPING_VERSION=
FEISHU_COUPON_THREE_SOURCE_R2_RENDERER_URL=
# The runtime stage above must be `r2-draft-only` only after the managed ingress,
# PostgreSQL/object storage and worker rollout gates have passed. The direct-message
# event contract remains independently fail-closed until it is verified.
FEISHU_COUPON_THREE_SOURCE_R2_CHAT_CONTEXT_READY=false

# Used only to extract structured fields from the business user's text. Never expose in cards or clients.
DEEPSEEK_API_KEY=
# Optional; defaults shown below.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# P0 three-source AI recognition remains disabled unless the current pilot Gate is approved.
# It only proposes source candidates; owner confirmation and deterministic generation remain mandatory.
FEISHU_COUPON_THREE_SOURCE_P0_AI_RECOGNITION_ENABLED=false
FEISHU_COUPON_THREE_SOURCE_P0_AI_TIMEOUT_MS=45000
FEISHU_COUPON_THREE_SOURCE_P0_AI_PRIMARY_ENABLED=false
FEISHU_COUPON_THREE_SOURCE_P0_AI_SHADOW_ENABLED=false
FEISHU_COUPON_THREE_SOURCE_P0_ACTIVITY_COPY_ENABLED=false
FEISHU_COUPON_THREE_SOURCE_P0_PUBLIC_CALENDAR_ENABLED=false
FEISHU_COUPON_THREE_SOURCE_P0_PUBLIC_CALENDAR_ENDPOINT=
FEISHU_COUPON_THREE_SOURCE_P0_PUBLIC_CALENDAR_TIMEOUT_MS=5000

# Administrator API: local development only. Never enable development mode in production.
ADMIN_AUTH_MODE=development
ADMIN_DEV_OPEN_IDS=ou_replace_with_test_admin
ADMIN_ALLOWED_ORIGINS=http://localhost:5173
