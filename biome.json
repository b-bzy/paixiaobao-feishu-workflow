{
  "$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "files": {
    "includes": [
      "server/**/*.ts",
      "apps/miaoda-admin/src/**/*.{ts,tsx,css}",
      "apps/miaoda-admin/*.json",
      "*.ts",
      "*.json"
    ]
  }
}
