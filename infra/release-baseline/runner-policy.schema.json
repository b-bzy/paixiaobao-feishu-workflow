{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fdev001-runner-policy-v1",
  "title": "FDEV-001 protected hermetic runner policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "noEgressPolicyId",
    "noEgressImage",
    "postgresOnlyPolicyId",
    "postgresOnlyImage",
    "postgresTarget",
    "dockerEngineMajor",
    "auditRunId"
  ],
  "properties": {
    "schemaVersion": { "const": "fdev001-runner-policy-v1" },
    "noEgressPolicyId": { "const": "fdev001-no-egress-v1" },
    "noEgressImage": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
    },
    "postgresOnlyPolicyId": { "const": "fdev001-postgres-only-v1" },
    "postgresOnlyImage": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
    },
    "postgresTarget": { "const": "fdev001-postgres17-isolated-v1" },
    "dockerEngineMajor": { "const": 28 },
    "auditRunId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$"
    }
  }
}
